# 画像解析の AI Vision。GROQ 推奨（無料枠・カード不要・すぐ使える）。
# https://console.groq.com → API Keys → Create（gsk_... で始まる）
GROQ_API_KEY=

# Gemini を使う場合（GROQ_API_KEY が無いときに使われる）
# GEMINI_API_KEY=

# キー無しで通しの動作確認（画像を見ずに擬似特徴）
# GROQ_API_KEY=mock

# モデル上書き（省略時 Groq=llama-4-scout / Gemini=gemini-2.5-flash）
# RAKUGAKI_AI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
