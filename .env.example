# 画像解析の AI Vision（Google Gemini）用。
# https://aistudio.google.com/apikey で無料キーを取得（AIza... で始まる）。
# 未設定なら AI をスキップしてローカルのピクセル解析にフォールバックする。
GEMINI_API_KEY=

# キー無しで通しの動作確認をしたいとき（画像を見ずに擬似特徴を返す）
# GEMINI_API_KEY=mock
#   または
# RAKUGAKI_AI_MOCK=1

# 省略時 gemini-2.5-flash（無料枠で十分。gemini-2.0-flash でも可）
# RAKUGAKI_AI_MODEL=gemini-2.5-flash
