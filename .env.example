# 画像解析の AI Vision。GROQ 推奨（無料枠・カード不要・すぐ使える）。
# https://console.groq.com → API Keys → Create（gsk_... で始まる）
GROQ_API_KEY=

# Gemini を使う場合（GROQ_API_KEY が無いときに使われる）
# GEMINI_API_KEY=

# キー無しで通しの動作確認（画像を見ずに擬似特徴）
# GROQ_API_KEY=mock

# モデル上書き（省略時 Groq=llama-4-scout / Gemini=gemini-2.5-flash）
# RAKUGAKI_AI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- スマホ読み取り（QR連携）用。Vercel等サーバーレスにデプロイする場合のみ必要 ---
# ローカルの `npm run dev`/`npm run preview` では未設定でOK（プロセス内メモリで動く）。
# Vercel等は呼び出しごとに別インスタンスになりうるため、セッションの受け渡しに
# 外部ストアが要る。Upstash Redis（https://upstash.com、無料枠あり）でDB作成後、
# 「REST API」のURL/TOKENをコピーしてここ（と Vercel の Environment Variables）に設定。
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
